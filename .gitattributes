# Normalize text files.
* text=auto

# Documentation and config files should stay LF across platforms.
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Windows scripts, if added later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
