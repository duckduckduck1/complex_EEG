# Runtime environment example for the local VM.
# Copy values into /opt/complex_eeg/config/.env on the server.

APP_ENV=local
ENABLE_LOCAL_UPLOAD_ENDPOINT=false
APP_BASE_URL=http://localhost:8000
DATA_ROOT=/srv/complex_eeg
API_PORT=8000
WEB_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_in_ansible_vault

# Host user/group IDs used by non-root application containers.
# On the VM, set APP_UID to `id -u deploy` and APP_GID to `getent group complex_eeg | cut -d: -f3`.
APP_UID=1000
APP_GID=1000

POSTGRES_DB=complex_eeg
POSTGRES_USER=complex_eeg
POSTGRES_PASSWORD=change_me_in_ansible_vault
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=/srv/complex_eeg/postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_ansible_vault
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=/srv/complex_eeg/minio
MINIO_BUCKET_BRONZE=lakehouse-bronze
MINIO_BUCKET_SILVER=lakehouse-silver
MINIO_BUCKET_GOLD=lakehouse-gold
MINIO_BUCKET_DERIVED=lakehouse-derived

EXPERIMENTS_DIR=/srv/complex_eeg/experiments
PIPELINE_RESULTS_DIR=/srv/complex_eeg/pipeline_results
UPLOAD_TMP_DIR=/srv/complex_eeg/upload_tmp
BACKUP_DIR=/backup/complex_eeg
BACKUP_STATUS_DIR=/backup/complex_eeg/status
LOG_DIR=/var/log/complex_eeg
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

AUTH_SECRET=change_me_in_ansible_vault
SESSION_COOKIE_NAME=complex_eeg_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
ALERTMANAGER_TOKEN=change_me_in_ansible_vault
UPLOAD_MAX_SIZE=10737418240
UPLOAD_SESSION_TTL_HOURS=24
PIPELINE_VERSION=dev
PIPELINE_POLL_INTERVAL_SECONDS=5
PIPELINE_MAX_RUN_DURATION_HOURS=6
PIPELINE_STUCK_HEARTBEAT_MINUTES=15

API_IMAGE=complex-eeg-api:local
WEB_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.15.0
